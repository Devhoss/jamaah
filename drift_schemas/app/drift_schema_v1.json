  "fixed_sql": [
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "adhan_alert_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"adhan_alert_rows\" (\"prayer\" TEXT NOT NULL CHECK (prayer IN ('fajr','sunrise','dhuhr','asr','maghrib','isha')), \"enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"enabled\" IN (0, 1)), \"sound_override\" TEXT NULL CHECK (sound_override IN ('full','short','standard','silent')), PRIMARY KEY (\"prayer\"));"
        }
      ]
    },
    {
      "name": "prayer_offsets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"prayer_offsets\" (\"prayer\" TEXT NOT NULL CHECK (prayer IN ('fajr','sunrise','dhuhr','asr','maghrib','isha')), \"minutes\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"prayer\"));"
        }
      ]
    },
    {
      "name": "mosques",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mosques\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"address\" TEXT NOT NULL, \"source\" TEXT NOT NULL CHECK (source IN ('google','osm','manual')), \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"place_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedules\" (\"id\" TEXT NOT NULL, \"mosque_id\" TEXT NOT NULL REFERENCES mosques (id) ON DELETE CASCADE, \"effective_from\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "schedule_prayers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedule_prayers\" (\"schedule_id\" TEXT NOT NULL REFERENCES schedules (id) ON DELETE CASCADE, \"prayer\" TEXT NOT NULL CHECK (prayer IN ('fajr','dhuhr','asr','maghrib','isha')), \"iqama_minutes\" INTEGER NULL, \"reminder_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reminder_enabled\" IN (0, 1)), \"reminder_minutes_before\" INTEGER NOT NULL DEFAULT 10, PRIMARY KEY (\"schedule_id\", \"prayer\"));"
        }
      ]
    }
