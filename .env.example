# Copy to .env and fill in. .env is git-ignored; pass it with:
#   flutter run --dart-define-from-file=.env
DISCOVERY_PROVIDER=google
GOOGLE_PLACES_API_KEY=your-places-api-key-here

# Optional. Enables tester-consented crash and diagnostics reporting to Sentry.
# Leave empty to keep reports on-device and use the Android share sheet.
SENTRY_DSN=

