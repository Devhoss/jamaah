<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash (dark): the evening sky with the Saff + Mihrab
         mark, the same in light and dark (docs/design-brief/brand/saff-mihrab-a).
         The icon animates (arch draws, the row gathers, you step in last),
         ending at the ~1 s cut: the duration is documentation, geometry lives
         in make_brand.py. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
